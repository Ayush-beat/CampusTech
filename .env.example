# Ledger. - Student Financial OS
# Root Environment Example

# Database (Default: SQLite local database)
DATABASE_URL=sqlite:///./backend/ledger.db

# Production MySQL Example:
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/ledger_db

# Security & Secrets
SECRET_KEY=ledger-production-secret-student-financial-os-2026-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Currency Formatting
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹
